# Testnet only. Never put a mainnet mnemonic in this file.
CHEQD_NETWORK=testnet
CHEQD_RPC_URL=https://rpc.cheqd.network
# Generate with: npm run 01:wallet
CHEQD_MNEMONIC=

# cheqd Studio funds testnet wallets. `npm run 00:login` signs you in (or up) in the browser and fills in
# STUDIO_API_KEY, or create a key in the Studio portal (Basic or Build plan, or the 30-day trial).
STUDIO_API_URL=https://studio-api.cheqd.net
STUDIO_API_KEY=
