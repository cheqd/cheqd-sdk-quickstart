# Testnet only. Never put a mainnet mnemonic in this file.
CHEQD_NETWORK=testnet
CHEQD_RPC_URL=https://rpc.cheqd.network
# Generate with: npm run 01:wallet
CHEQD_MNEMONIC=

# cheqd Studio funds testnet wallets. Create an API key in the Studio portal
# (needs a Basic or Build plan: the key must carry the request:faucet:testnet scope).
STUDIO_API_URL=https://studio-api.cheqd.net
STUDIO_API_KEY=
